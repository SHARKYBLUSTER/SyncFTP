# FTP Connection Configuration
# Copiez ce fichier en .env et modifiez les valeurs

# Obligatoire
FTP_HOST=localhost
FTP_PORT=21
FTP_USERNAME=anonymous
FTP_PASSWORD=

# Optionnel (valeurs par défaut si non définies)
FTP_USE_SSL=false
FTP_TIMEOUT=30

# Test de répertoire
FTP_TEST_DIRECTORY_ENABLED=false
FTP_TEST_DIRECTORY=/chemin/vers/votre/dossier
